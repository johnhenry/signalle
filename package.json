{
  "name": "@johnhenry/signalle",
  "version": "0.1.1",
  "description": "Beautiful, modern signals with optional DOM integration",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.mjs"
    },
    "./dom": {
      "types": "./dist/types.d.ts",
      "import": "./dist/dom.mjs"
    },
    "./stream": {
      "types": "./dist/types.d.ts",
      "import": "./dist/stream.mjs"
    },
    "./scope": {
      "types": "./dist/types.d.ts",
      "import": "./dist/scope.mjs"
    },
    "./broadcast": {
      "types": "./dist/types.d.ts",
      "import": "./dist/broadcast.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "mkdir -p dist && cp src/*.mjs dist/ && cp src/types.d.ts dist/",
    "dev": "nodemon --watch src --ext mjs,ts --exec \"npm run build\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "signal",
    "signals",
    "reactive",
    "state",
    "computed",
    "effect",
    "fine-grained",
    "reactivity",
    "dom"
  ],
  "author": "John Henry",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^25.0.0",
    "nodemon": "^3.0.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/signalle.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/signalle/issues"
  },
  "homepage": "https://opensource.johnhenry.me/signalle/"
}